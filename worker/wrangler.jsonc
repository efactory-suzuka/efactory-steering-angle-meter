{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "efactory-usage-counter",
  "account_id": "3d78b5680772e0d3714238c71cefbcf0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "send_metrics": false,
  "workers_dev": true,
  "preview_urls": false,
  "logpush": false,
  "observability": {"enabled":false,"logs":{"enabled":false,"invocation_logs":false},"traces":{"enabled":false}},
  "d1_databases": [{"binding":"COUNTERS","database_name":"efactory-usage","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"1001","simple":{"limit":120,"period":60}}]
}
