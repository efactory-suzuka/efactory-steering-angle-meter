{
  "name": "efactory-usage-counter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "test": "pnpm build && vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply efactory-usage --local",
    "migrate:remote": "wrangler d1 migrations apply efactory-usage --remote"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "miniflare": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
